# Configuração da versão de produção.
# Copie para .env.production.local (fica fora do git) e preencha. Ver PRODUCAO.md.

# Servidor de sincronização (o seu projeto Supabase). Com isto, quem usa o app só digita o e-mail.
# A chave anon/publishable é pública por natureza: quem protege os dados é a segurança por linha do banco.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: Client ID do Google para a Agenda (na web).
VITE_GOOGLE_CLIENT_ID=

# Open Finance pelo Meu Pluggy: o plano gratuito é só para uso pessoal (um CPF).
# Em versões para outras pessoas, deixe "desligado" até ter o plano comercial da Pluggy (ver PRODUCAO.md).
VITE_OPEN_FINANCE=desligado
