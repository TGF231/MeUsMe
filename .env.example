# Variáveis de build. Copie para .env.production.local (ignorado pelo git) e preencha; ver PRODUCAO.md.

# Servidor de sincronização (Supabase). A chave anon é pública; o isolamento entre usuários é feito por RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: Client ID do Google para a Agenda (na web).
VITE_GOOGLE_CLIENT_ID=

# Open Finance (Meu Pluggy): restrito a uso pessoal. Fica escondido, a não ser com "ligado" (só em builds para você).
VITE_OPEN_FINANCE=
