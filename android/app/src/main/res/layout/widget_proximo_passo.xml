<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Próximo passo" (V01 em docs/CONCORRENTES.md). Botões com 48dp de altura. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_rotulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_rotulo"
        android:textColor="@color/widget_texto2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_passo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingTop="2dp"
        android:text="@string/widget_vazio"
        android:textColor="@color/widget_texto"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/widget_capturar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/widget_botao"
            android:gravity="center"
            android:text="@string/widget_capturar"
            android:textColor="@color/widget_sobre_acento"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_voz"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_botao_linha"
            android:gravity="center"
            android:text="@string/widget_voz"
            android:textColor="@color/widget_texto"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
